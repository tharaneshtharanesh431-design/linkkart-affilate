# Database
DATABASE_URL=jdbc:mysql://localhost:3306/linkkart?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DATABASE_USERNAME=root
DATABASE_PASSWORD=replace_me

# Authentication
JWT_SECRET=replace_me_with_base64_encoded_minimum_256_bit_secret
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
IP_HASH_SALT=replace_me_with_random_string

# Features
GEMINI_API_KEY=replace_me

# Email
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USERNAME=replace_me
EMAIL_PASSWORD=replace_me

# Frontend
FRONTEND_URL=http://localhost:3000
